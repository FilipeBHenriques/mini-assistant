{
  "name": "mini-assistant",
  "version": "1.0.0",
  "main": "main.js",
  "homepage": "./",
  "scripts": {
    "dev:renderer": "vite",
    "dev:main": "wait-on http://localhost:5173 && electron .",
    "dev": "concurrently -k \"yarn dev:renderer\" \"yarn dev:main\"",
    "build": "vite build",
    "start": "electron .",
    "start-app": "start cmd /k \"ollama serve\" && start cmd /k \"yarn dev\""
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^1.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.0.0",
    "autoprefixer": "^10.4.22",
    "concurrently": "^9.2.1",
    "electron": "^37.3.1",
    "electron-rebuild": "^3.2.9",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.17",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "wait-on": "^8.0.4"
  },
  "dependencies": {
    "@hurdlegroup/robotjs": "^0.12.3",
    "@langchain/core": "^1.0.3",
    "@langchain/ollama": "^1.0.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.4",
    "@tailwindcss/postcss": "^4.1.17",
    "@tailwindcss/vite": "^4.1.17",
    "active-win": "^9.0.0",
    "button": "^1.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "command": "^1.1.1",
    "desktop-idle": "^1.3.0",
    "fast-fuzzy": "^1.12.0",
    "get-installed-apps": "^1.1.1",
    "get-windows": "^9.2.0",
    "langchain": "^1.0.3",
    "lucide-react": "^0.555.0",
    "node-window-manager": "^2.2.4",
    "open": "^11.0.0",
    "openai": "^6.2.0",
    "popover": "^2.4.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "shadcn": "^3.5.1",
    "systeminformation": "^5.27.11",
    "tailwind-merge": "^3.4.0",
    "tailwindcss-animate": "^1.0.7",
    "three": "^0.179.1",
    "zod": "^4.1.12"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
