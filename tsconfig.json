{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "outDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "lib": ["dom", "es2020"],
    "moduleResolution": "node",
    "jsx": "react-jsx",
    "allowJs": true,
    "checkJs": false
  },
  "include": ["**/*.{ts,tsx,js,jsx}"],

  "exclude": ["node_modules", "dist"]
}
